# Public site URL (used for canonical URLs, OG tags, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://inspireafricans.com

# Strapi connection (server-side fetches).
STRAPI_BASE_URL=http://localhost:1337
STRAPI_PUBLIC_TOKEN=
REVALIDATE_SECRET=

# Public origin that serves Strapi-uploaded media (/uploads/**). Used to
# turn relative Strapi media URLs absolute AND to derive next/image's
# allowed remotePatterns. Set to the browser-reachable host (e.g.
# http://37.60.225.220:1337 or https://cms.inspireafricans.com). Falls
# back to STRAPI_BASE_URL when unset.
STRAPI_MEDIA_URL=http://localhost:1337

# Visitor analytics — server-side ingest proxy → CMS collect endpoint.
# ANALYTICS_INGEST_TOKEN must match the value set on the CMS.
ANALYTICS_INGEST_URL=http://localhost:1337/api/analytics/collect
ANALYTICS_INGEST_TOKEN=

# Community signup capture (/join/start). Server-side only — never exposed
# to the browser. COMMUNITY_SIGNUP_TOKEN must match the value on the CMS,
# and is deliberately a DIFFERENT secret from ANALYTICS_INGEST_TOKEN
# because these endpoints write PII.
# Optional: defaults to STRAPI_BASE_URL when unset.
COMMUNITY_SIGNUP_URL=http://localhost:1337
COMMUNITY_SIGNUP_TOKEN=
# Renders the optional password field on the signup form. Keep `off` unless
# the CMS also has COMMUNITY_SIGNUP_PASSWORD=on — a password here logs into
# nothing until Mighty Networks SSO exists. See docs/19-community-signup.md.
COMMUNITY_SIGNUP_PASSWORD=off

# Profile wizard (signup steps 2+). Uses the same COMMUNITY_SIGNUP_URL /
# COMMUNITY_SIGNUP_TOKEN as step 1. The CMS additionally needs
# COMMUNITY_PII_KEY set, or profile writes fail closed with 503.
